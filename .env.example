# Copy to .env and fill in. Every variable the source reads belongs here, with
# what it does and whether production requires it.

# How hard guard_publish pushes back on a publish or a release.
# Required in production: no
# Default: strict
# Values: off | warn | strict
REPO_RELEASE_MODE=

# Where the hook stores the user's [publish-ok] approvals.
# Required in production: no
# Default: ~/.claude/state/repo-release
REPO_RELEASE_STATE=

# Set by the harness to the plugin's install directory. The hook uses it to
# find the plugin's own config.json. Do not set it by hand.
# Required in production: no
CLAUDE_PLUGIN_ROOT=
