# Copy to .env and fill in. Every variable the source reads belongs here, with
# what it does and whether production requires it.
#
# The negation rule in .gitignore keeps this file while excluding .env itself:
#   .env
#   .env.*
#   !.env.example
#
# An ignored .env with real values is the most common way a credential leaks.

# <what it controls, and what breaks when it is unset>
# Required in production: yes
# Generate with: openssl rand -hex 32
EXAMPLE_TOKEN=

# <what it controls>
# Required in production: no
# Default: localhost
EXAMPLE_HOST=
